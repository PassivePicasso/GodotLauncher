<local:CommandingWindow x:Class="GodotLauncher.View.MainWindow"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
                        xmlns:local="clr-namespace:GodotLauncher.View"
                        mc:Ignorable="d"
        Title="Godot Launcher" Height="600" Width="1000"
        x:Name="Root"
        Background="{DynamicResource NormalBackgroundBrush}"
        DataContext="{Binding Source={StaticResource MainViewModel}}"
        SnapsToDevicePixels="True"
        OnLoadedCommand="{Binding Source={StaticResource MainViewModel}, Path=LoadGithubSourcesCommand}"
        OnClosingCommand="{Binding Source={StaticResource MainViewModel}, Path=SaveCommand}"
        >

    <TabControl TabStripPlacement="Left" Margin="0" Padding="0">
        <TabItem Header="Engines">
            <Grid Background="Transparent" Grid.Row="0" Margin="5,5,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.RowSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="0,0,1,1" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,2,0" Padding="4,2" Text="Engines Root Path"/>
                    <TextBox Width="300" Height="20" FontSize="13" Text="{Binding Path=Data.EnginesRootDirectory}"/>
                    <Button Height="20" Margin="4,0,2,1" Padding="8,0" Command="{Binding Path=BrowseForEngineFolderCommand}">Browse</Button>
                    <Button Height="20" Margin="4,0,2,1" Padding="8,0" Command="{Binding Path=ScanForEnginesCommand}">Scan</Button>
                    <Button Height="20" Margin="4,0,2,1" Padding="8,0" Command="{Binding Path=ClearEnginesCommand}">Clear</Button>
                </StackPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Path=Data.Engines}" AutoGenerateColumns="False"
                      >
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Path=Name}" EditingElementStyle="{DynamicResource {x:Type TextBox}}"/>
                        <DataGridTextColumn Header="Path" Binding="{Binding Path=Path}" EditingElementStyle="{DynamicResource {x:Type TextBox}}"/>
                        <DataGridTextColumn Header="Arguments" Binding="{Binding Path=Arguments}" EditingElementStyle="{DynamicResource {x:Type TextBox}}"/>
                        <DataGridTemplateColumn>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Launch" Padding="4,1" Command="{Binding Path=LaunchCommand}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Projects">
            <Grid Background="Transparent" Grid.Row="1" Margin="5,5,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="00.5*"/>
                </Grid.RowDefinitions>
                <Border Grid.RowSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="0,0,1,0" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,2,0" Padding="4,2" Text="Projects Root Path"/>
                    <TextBox Width="300" Height="20" FontSize="13" Text="{Binding Path=Data.ProjectsRootDirectory}"/>
                    <Button Height="20" Margin="4,0,2,1" Padding="8,0" Command="{Binding Path=BrowseForProjectFolderCommand}">Browse</Button>
                    <Button Height="20" Margin="4,0,2,1" Padding="8,0" Command="{Binding Path=ScanForProjectsCommand}">Scan</Button>
                    <Button Height="20" Margin="4,0,2,1" Padding="8,0" Command="{Binding Path=ClearProjectsCommand}">Clear</Button>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0">
                    <ItemsControl ItemsSource="{Binding Path=Data.Projects}"
                         Background="Transparent"
                         VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                         ItemTemplate="{DynamicResource ProjectListItemTemplate}"/>
                </ScrollViewer>
            </Grid>
        </TabItem>

        <TabItem Header="Install">
            <Grid>
                <Border  Width="500" Height="50" HorizontalAlignment="Right" VerticalAlignment="Top"
                             BorderThickness="1">
                    <WrapPanel DataContext="{Binding ElementName=GithubSourcesControl, Path=SelectedItem.Repository}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <TextBlock Text="{Binding Path=ApiInfo.Limit, StringFormat={}Rate Limit(Hour) {0}}"  Margin="4,1"/>
                        <TextBlock Text="{Binding Path=ApiInfo.Remaining, StringFormat={}Limit Remaining(Hour) {0}}"  Margin="4,1"/>
                        <TextBlock Text="{Binding Path=ApiInfo.ResetTime, StringFormat={}Reset Time {0:hh:mm tt}}"  Margin="4,1"/>
                        <TextBlock Text="{Binding Path=ApiInfo.LastRequest, StringFormat={}Last Request Time {0:hh:mm tt}}"  Margin="4,1"/>
                    </WrapPanel>
                </Border>

                <TabControl x:Name="GithubSourcesControl" ItemsSource="{Binding Path=GithubSources}"
                                ContentTemplate="{DynamicResource GithubSourceTemplate}" Margin="0,20,0,0"
                                >

                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Template" Value="{DynamicResource TabControlTabItemTemplate}"/>
                            <Setter Property="HeaderTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Path=Owner}" />
                                            <TextBlock Text="{Binding Path=RepositoryName}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                </TabControl>
            </Grid>
        </TabItem>

        <TabItem Header="Plugins">

        </TabItem>

        <TabItem Header="Settings">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="1" BorderBrush="{DynamicResource NormalBorderBrush}"
                        BorderThickness="1,0,0,0" >
                    <StackPanel Orientation="Vertical">
                        <TextBlock Style="{StaticResource HeaderTextBlock}" Text="Theme" 
                           HorizontalAlignment="Right" VerticalAlignment="Top" 
                           Margin="0,-4,100,0"/>

                        <Separator HorizontalAlignment="Stretch" VerticalAlignment="Top" 
                           Margin="0,0,0,0"/>
                        <WrapPanel DataContext="{StaticResource LoadedTheme}" 
                       HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="230"
                           Margin="8,28,2,2" >
                            <WrapPanel.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Padding" Value="6,10,0,0"/>
                                    <Setter Property="Width" Value="70"/>
                                    <Setter Property="FlowDirection" Value="RightToLeft"/>
                                </Style>
                            </WrapPanel.Resources>
                            <TextBlock>Normal</TextBlock>
                            <colorpicker:PortableColorPicker ToolTip="Background" SelectedColor="{Binding Path=NormalBackgroundColor, Mode=TwoWay}"/>
                            <colorpicker:PortableColorPicker ToolTip="Foreground" SelectedColor="{Binding Path=NormalForegroundColor, Mode=TwoWay}"/>
                            <colorpicker:PortableColorPicker ToolTip="Border"     SelectedColor="{Binding Path=NormalBorderColor,     Mode=TwoWay}"/>
                            
                            <TextBlock>Interactable</TextBlock>
                            <colorpicker:PortableColorPicker ToolTip="Background" SelectedColor="{Binding Path=EditableBackgroundColor, Mode=TwoWay}"/>
                            <colorpicker:PortableColorPicker ToolTip="Foreground" SelectedColor="{Binding Path=EditableForegroundColor, Mode=TwoWay}"/>
                            <colorpicker:PortableColorPicker ToolTip="Border"     SelectedColor="{Binding Path=EditableBorderColor,     Mode=TwoWay}"/>

                            <TextBlock>Hover</TextBlock>
                            <colorpicker:PortableColorPicker ToolTip="Background"    SelectedColor="{Binding Path=HoverBackgroundColor,    Mode=TwoWay}"/>
                            <colorpicker:PortableColorPicker ToolTip="Foreground"    SelectedColor="{Binding Path=HoverForegroundColor,    Mode=TwoWay}"/>
                            <colorpicker:PortableColorPicker ToolTip="Border"        SelectedColor="{Binding Path=HoverBorderColor,        Mode=TwoWay}"/>

                            <TextBlock>Active</TextBlock>
                            <colorpicker:PortableColorPicker ToolTip="Background"   SelectedColor="{Binding Path=ActiveBackgroundColor,   Mode=TwoWay}"/>
                            <colorpicker:PortableColorPicker ToolTip="Foreground"   SelectedColor="{Binding Path=ActiveForegroundColor,   Mode=TwoWay}"/>
                            <colorpicker:PortableColorPicker ToolTip="Border"       SelectedColor="{Binding Path=ActiveBorderColor,       Mode=TwoWay}"/>

                            <TextBlock>Disable</TextBlock>
                            <colorpicker:PortableColorPicker ToolTip="Background" SelectedColor="{Binding Path=DisabledBackgroundColor, Mode=TwoWay}"/>
                            <colorpicker:PortableColorPicker ToolTip="Foreground" SelectedColor="{Binding Path=DisabledForegroundColor, Mode=TwoWay}"/>
                            <colorpicker:PortableColorPicker ToolTip="Border"     SelectedColor="{Binding Path=DisabledBorderColor,     Mode=TwoWay}"/>

                            <TextBlock>Selection</TextBlock>
                            <colorpicker:PortableColorPicker ToolTip="Background" SelectedColor="{Binding Path=SelectedBackgroundColor, Mode=TwoWay}"/>
                            <colorpicker:PortableColorPicker ToolTip="Foreground" SelectedColor="{Binding Path=SelectedForegroundColor, Mode=TwoWay}"/>
                            <colorpicker:PortableColorPicker ToolTip="Highlight" SelectedColor="{Binding Path=SelectionHighlightColor, Mode=TwoWay}"/>

                            <TextBlock>Glyph</TextBlock>
                            <colorpicker:PortableColorPicker ToolTip="Glyph" SelectedColor="{Binding Path=GlyphColor,                  Mode=TwoWay}"/>
                            <!--Use this to fill space if necessary-->
                            <!--<Rectangle Width="32" Height="32" Fill="Transparent" Stroke="Transparent" Margin="4,0"/>-->

                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</local:CommandingWindow>
