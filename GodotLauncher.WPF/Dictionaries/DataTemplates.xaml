<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:GodotLauncher.ViewModels;assembly=GodotLauncher.ViewModels"
                    xmlns:vmg="clr-namespace:GodotLauncher.ViewModels.Github;assembly=GodotLauncher.ViewModels"
                    xmlns:s="clr-namespace:System;assembly=mscorlib" xmlns:converters="clr-namespace:GodotLauncher.Converters">

    <converters:BooleanInverter x:Key="BoolInverter" />

    <ItemsPanelTemplate x:Key="HorizontalPanel">
        <StackPanel Orientation="Horizontal"/>
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="HorizontalWrapPanel">
        <WrapPanel Orientation="Horizontal"/>
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="VerticalVirtualizaingStackPanel">
        <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True"/>
    </ItemsPanelTemplate>

    <DataTemplate x:Key="TagTemplate" DataType="{x:Type s:String}">
        <Border CornerRadius="6" Padding="4,1" Margin="2,0" Background="{DynamicResource ActiveBackgroundBrush}">
            <TextBlock Text="{Binding}" VerticalAlignment="Center" Padding="0" Margin="0,0,0,1" />
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="ComboBoxGodotInstallTemplate" DataType="{x:Type vm:GodotInstallation}">
        <TextBlock Text="{Binding Path=Name}" Foreground="{DynamicResource EditableForegroundBrush}"/>
    </DataTemplate>

    <DataTemplate x:Key="ProjectListItemTemplate" DataType="{x:Type vm:Project}">
        <Border BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="14,1,1,1" Margin="0,2,1,2"
                Background="{DynamicResource EditableBackgroundBrush}">
            <Grid HorizontalAlignment="Stretch" Margin="0,2">
                <Grid.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource ResourceKey={x:Type TextBlock}}">
                        <Setter Property="HorizontalAlignment" Value="Right"/>
                        <Setter Property="Margin" Value="0,0,8,0" />
                    </Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource ResourceKey={x:Type TextBox}}">
                        <Setter Property="IsReadOnly" Value="True"/>
                        <Setter Property="Margin" Value="0,0,8,0" />
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0">Name</TextBlock>
                <TextBlock Grid.Row="2">Path</TextBlock>
                <TextBlock Grid.Row="4">Features</TextBlock>
                <TextBlock Grid.Row="6">Plugins</TextBlock>
                <TextBlock Grid.Row="8">Editor</TextBlock>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Path=Name}" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Path=Path}" />

                <ItemsControl Grid.Row="4" Grid.Column="1"
                              ItemsSource="{Binding Path=FeatureTags}" 
                              ItemTemplate="{DynamicResource TagTemplate}" 
                              ItemsPanel="{DynamicResource HorizontalWrapPanel}"/>


                <ItemsControl Grid.Row="6" Grid.Column="1"
                              ItemsSource="{Binding Path=Plugins}" 
                              ItemTemplate="{DynamicResource TagTemplate}" 
                              ItemsPanel="{DynamicResource HorizontalWrapPanel}"/>

                <ComboBox ItemsSource="{Binding Source={StaticResource MainViewModel}, Path=Data.Engines}"
                          SelectedItem="{Binding LaunchInstallation}"
                          Grid.Row="8" Grid.Column="1"
                          Margin="0"
                          ItemTemplate="{DynamicResource ComboBoxGodotInstallTemplate}"/>

                <Button Grid.Row="0" Grid.RowSpan="15" Grid.Column="2" Margin="0,0,2,0" VerticalAlignment="Top"
                        Content="Launch" Command="{Binding LaunchCommand}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="GithubSourceTemplate" DataType="{x:Type vm:GithubSource}">
        <Grid DataContext="{Binding Path=Repository}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" >
                <TextBlock Style="{StaticResource HeaderTextBlock}" Text="About"/>
                <Separator/>
                <TextBlock Text="{Binding Path=FullName, StringFormat={}Repo Name: {0}}"/>
                <TextBlock Text="{Binding Path=Description, StringFormat={}Description: {0}}"/>
                <TextBlock Text="{Binding Path=Url, StringFormat={}Repository: {0}}"/>
                <TextBlock Text="{Binding Path=UpdatedAt, StringFormat={}Last Updated: {0}}"/>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="Releases" Style="{StaticResource HeaderTextBlock}" />
            <Separator Grid.Column="1" Margin="0,37,0,0" VerticalAlignment="Top"/>
            <Border Grid.Column="1" Background="{DynamicResource EditableBackgroundBrush}" Margin="0,40,0,0">
                <ItemsControl ItemsSource="{Binding Path=Releases}" Margin="0,0,0,0" ScrollViewer.CanContentScroll="True"
                              VerticalAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True"
                              Template="{StaticResource VirtualizingItemsControlTemplate}"
                              ItemsPanel="{StaticResource VerticalVirtualizaingStackPanel}"
                              />
            </Border>
        </Grid>
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type vmg:ReleaseViewModel}">
        <Border BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" Margin="0,0,1,4" Padding="2">
            <WrapPanel>
                <ContentPresenter Content="{Binding Path=TagName}" 
                                  ContentTemplate="{DynamicResource TagTemplate}" 
                                  Margin="2" Width="80" />
                <TextBlock Width="75">
                    <Hyperlink NavigateUri="{Binding Path=Url}" Foreground="{DynamicResource EditableForegroundBrush}"
                        ToolTip="{Binding Path=Url}">
                        <TextBlock Text="{Binding Path=Name}" Foreground="{DynamicResource EditableForegroundBrush}"/>
                    </Hyperlink>
                </TextBlock>
                <TextBlock Text="{Binding Path=PublishedAt, StringFormat={}d}" Margin="2" Width="65"/>
                <ComboBox ItemsSource="{Binding Path=Assets}" SelectedIndex="0" MinWidth="220" x:Name="AssetSelector">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vmg:ReleaseAssetViewModel}">
                            <Border>
                                <TextBlock Text="{Binding Path=Name}"/>
                            </Border>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Download" 
                        Command="{Binding Path=DownloadCommand, Source={StaticResource MainViewModel}}"
                        CommandParameter="{Binding ElementName=AssetSelector, Path=SelectedItem}"
                        />
                <Button Content="Unpack" 
                        Command="{Binding Path=UnpackCommand, Source={StaticResource MainViewModel}}"
                        CommandParameter="{Binding ElementName=AssetSelector, Path=SelectedItem}"
                        />
                <ProgressBar Width="70" Height="15" Margin="225,2,0,0" Background="{DynamicResource NormalBackgroundBrush}"
                             BorderBrush="{StaticResource NormalBorderBrush}"/>

            </WrapPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>