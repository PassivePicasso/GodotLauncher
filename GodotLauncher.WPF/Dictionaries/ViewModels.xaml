<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:GodotLauncher.ViewModels;assembly=GodotLauncher.ViewModels"
                    >

    <vm:Theme x:Key="LoadedTheme" />

    <vm:DataViewModel x:Key="Data" />


    <vm:MainViewModel x:Key="MainViewModel"
                      Theme="{StaticResource LoadedTheme}"
                      Data="{StaticResource Data}">
        <vm:GithubSource Owner="godotengine" RepositoryName="godot"/>
        <vm:GithubSource Owner="godotengine" RepositoryName="godot-builds"/>
    </vm:MainViewModel>

</ResourceDictionary>